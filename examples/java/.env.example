# CDP API credentials
CDP_API_KEY_ID=your-api-key-id
CDP_API_KEY_SECRET=your-api-key-secret

# Required for EVM and Solana wallet write operations.
CDP_WALLET_SECRET=your-wallet-secret

# Optional identifiers used by examples.
CDP_EVM_ACCOUNT_ADDRESS=0x...
CDP_SOLANA_ACCOUNT_ADDRESS=...
CDP_END_USER_ID=...
CDP_CUSTODY_ACCOUNT_ID=account_...
CDP_CUSTODY_ACCOUNT_NAME=java-custody-example

# Optional request settings.
CDP_EVM_BALANCE_NETWORK=base-sepolia
CDP_SOLANA_BALANCE_NETWORK=solana-devnet
CDP_FAUCET_NETWORK=base-sepolia
CDP_FAUCET_TOKEN=eth
CDP_SWAP_NETWORK=base
CDP_SWAP_FROM_TOKEN=0x833589fCD6EDB6E08f4c7C32D4f71b54bdA02913
CDP_SWAP_TO_TOKEN=0xEeeeeEeeeEeEeeEeEeEeeEEEeeeeEeeeeeeeEEeE
CDP_SWAP_FROM_AMOUNT=1000000

# Flexible custody transfer example.
CDP_TRANSFER_TARGET_ADDRESS=0x...
CDP_TRANSFER_TARGET_NETWORK=base
CDP_TRANSFER_SOURCE_ASSET=usd
CDP_TRANSFER_TARGET_ASSET=usdc
CDP_TRANSFER_AMOUNT=1.00
# Keep false to request a transfer quote without moving funds.
CDP_TRANSFER_EXECUTE=false
# Required only when CDP_TRANSFER_EXECUTE=true.
CDP_TRANSFER_CONFIRMATION=
