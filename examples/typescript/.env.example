CDP_API_KEY_ID=your_api_key_id_here
CDP_API_KEY_SECRET=your_private_key_here
CDP_WALLET_SECRET=your_wallet_auth_key_here

# Optional, for the x402 client examples
# X402_API_URL=https://x402.vercel.app/protected
# X402_FUND_FROM_FAUCET=false

# Optional, for the x402 MCP chatbot client
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional, for the x402 server examples: receive payments at an address you
# already control instead of a CDP-provisioned wallet
# PAY_TO=0xYourReceiverAddress
